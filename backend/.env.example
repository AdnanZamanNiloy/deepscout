# =============================================================================
# DeepScout backend configuration
#
# YOU DO NOT NEED TO FILL ANYTHING IN TO START THE BACKEND.
#
# Copy this file to `.env` and run it as-is:
#
#     cp .env.example .env
#
# The LLM key is added from the UI, not from here: open the app, go to
# Model Controls (/#/model-controls — the legacy /#/providers still resolves
# there), add any OpenAI-compatible provider (OpenAI, Groq, Together,
# OpenRouter, a local vLLM/LM Studio/Ollama endpoint, ...), and select it.
# Keys are encrypted at rest in the SQLite database, and a selected provider
# becomes EXCLUSIVE: it is used instead of anything set below, and it takes
# effect on the very next call — no backend restart.
#
# Until a provider exists the backend still starts and serves the UI; a
# research run just returns a clear "no provider configured" error instead of
# quietly degrading to garbage.
#
# The only genuine setup step is SearXNG (below), which provides web search.
# Wikipedia, arXiv and Crossref need no service at all.
# =============================================================================


# --- LLM providers (ALL OPTIONAL) -------------------------------------------
# Nothing here is required: the Providers tab is the supported path. These
# exist for headless/CI use, or to seed a provider before the UI is reachable.
# Values starting with `your_` are treated as unset, so leaving any of these
# untouched costs nothing.

# GROQ_API_KEY=your_groq_api_key_here
# llama-3.1-8b-instant was decommissioned on Groq; gpt-oss-20b is verified working
# GROQ_MODEL=openai/gpt-oss-20b

# HUGGINGFACE_API_KEY=your_huggingface_api_key_here
# HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct

# Custom OpenAI-compatible provider. All three are required together, and it
# leads the chain ahead of Groq/HF. Useful for a headless box where the UI is
# not available.
# CUSTOM_LLM_API_KEY=your_custom_key_here
# CUSTOM_LLM_BASE_URL=https://your-provider.example/v1
# CUSTOM_LLM_MODEL=your-model-id-here

# Encrypts user-added provider keys at rest. Optional: without it a local
# backend/.deepscout_secret key file is created automatically on first use.
# DEEPSCOUT_SECRET_KEY=your_random_secret_here


# --- Search -----------------------------------------------------------------
# Search needs no external API key. SearXNG is a self-hosted metasearch
# engine and the PRIMARY web search; Wikipedia, arXiv and Crossref are queried
# directly and need no service at all.
#
# One-time setup (the backend does the rest on every start):
#
#     git clone https://github.com/searxng/searxng.git
#     cd searxng
#     python3 -m venv .venv && .venv/bin/pip install -U -r requirements.txt
#     cp settings.yml settings.local.yml   # then set server.secret_key
#
# SearXNG is a separate application reached over HTTP, so it CANNOT be embedded
# in the backend -- but it no longer has to be started by hand. With
# SEARXNG_AUTOSTART=true (the default) the backend spawns it on startup, waits
# for /healthz, and stops it on shutdown, so ONE command runs the whole system.
# An instance that is already running is never adopted or killed; it is left
# entirely alone. No container runtime required.
#
# It listens on 127.0.0.1:8080 by default, which is what SEARXNG_URL below
# already points at.
SEARXNG_URL=http://localhost:8080
# Set to false to skip SearXNG entirely (Wikipedia/arXiv/Crossref only).
SEARXNG_ENABLED=true
# Start SearXNG automatically as a child of the backend. Set to false to keep
# the old behaviour of managing it yourself.
SEARXNG_AUTOSTART=true
# How long startup waits for /healthz before giving up and degrading. Generous
# because a cold first boot imports a large dependency set.
SEARXNG_STARTUP_TIMEOUT_SEC=45
# Where the searxng clone lives. Empty = <repo_root>/searxng.
# SEARXNG_HOME=
# Interpreter used to run it. MUST be SearXNG's own virtualenv (flask, lxml,
# curl_cffi are not backend dependencies). Empty = <searxng_home>/.venv/bin/python
# SEARXNG_PYTHON=

# --- Runtime ---------------------------------------------------------------
DATABASE_URL=./research.db
MAX_PARALLEL_SEARCH=3
# Wave size for section research: how many report sections are researched at
# once. Each wave's writers also receive the sections already written.
MAX_PARALLEL_AGENTS=3
# Concurrent LLM calls across the whole pipeline. Sized so a free tier's
# TPM/TPD quota is not exhausted by a few parallel large prompts; a paid or
# large-context endpoint stalls at a low value, so raise it there.
MAX_PARALLEL_LLM=4
MAX_ITERATIONS=3
SEARCH_FETCH_TOP_N=10

# v3 retrieval knobs (wired for the v3 search port; inert until then)
MAX_PARALLEL_FETCH=4
SEARCH_RETRY_ATTEMPTS=3
MAX_QUERIES_PER_CONTRACT=3
SEARCH_MAX_RESULTS=15

# SearXNG tuning.
# Aggregating many upstream engines is slower than a single-provider API.
SEARXNG_TIMEOUT_SEC=30
# Requested upstream count. Higher than SEARCH_MAX_RESULTS on purpose: the
# ranker rejects duplicates and weak engines, and needs candidates to do that.
SEARXNG_MAX_RESULTS=30
# general=open web, science=scholarly indexes. Add `news` for current events.
SEARXNG_CATEGORIES=general,science
SEARXNG_LANGUAGE=en
# 0=off 1=moderate 2=strict. Off: safesearch silently truncates legitimate
# academic/medical results.
SEARXNG_SAFESEARCH=0
# Circuit-breaker cooldown for the SearXNG backend. Longer than the LLM
# breaker's 15s: this is a LOCAL service, so a restart is usually the fix.
SEARCH_SEARXNG_COOLDOWN_SEC=60
# Retrieval access hardening: hard-blocked (403/451) or repeatedly failing
# hosts cool down for this window so later passes stop re-hitting them.
# Transient fetch failures (429/timeout/5xx/connection) get bounded retries;
# 403 is never retried. Canonical URLs that failed this run are never
# re-fetched. The registry and failure memory are LRU-bounded.
SEARCH_DOMAIN_COOLDOWN_SEC=90
SEARCH_DOMAIN_FAILURE_THRESHOLD=3
SEARCH_DOMAIN_REGISTRY_MAX=512
SEARCH_FAILED_URL_MEMORY_MAX=2048
SEARCH_FETCH_RETRY_ATTEMPTS=2
SEARCH_PRIMARY_FALLBACK_ENABLED=true
SEARCH_PRIMARY_FALLBACK_MAX=2

# Research-run operational limits. Wall-clock and call ceilings are liveness
# guards (a stalled provider must not hold the run past the deadline; the
# fan-out needs a runaway guard). There is NO cost/dollar budget.
MAX_LLM_CALLS=60
MAX_RESEARCH_SECONDS=300
LLM_TIMEOUT_SEC=25
# Circuit breaker: consecutive failures before a provider is parked, and how
# long it stays parked. Kept short because a healthy answer takes ~2-3s; a long
# cooldown turns one upstream 503 into a minute of degraded answers.
LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_COOLDOWN_SEC=15
# How long ONE call may wait for an open breaker to close before the run
# degrades. The breaker assumes a provider *chain* — "skip this one, try the
# next". With a single provider there is no next, so one slow call parked it and
# every later call in that run failed instantly: measured live, one analyst
# timeout degraded the analyst AND all four synthesizer sections in the same
# second. One bounded wait per call turns that into a slower, fully executed
# run. Set 0 to restore fail-fast-everywhere.
LLM_BREAKER_WAIT_CAP_SEC=25
# Custom provider only: slower OpenAI-compatible hosts need 30-60s on
# planner-sized prompts and stall past 60s under load; a premature timeout
# trips the breaker and degrades runs. Worst case stays inside the research
# budget (90s custom + 25s groq, one pass, no timeout retries).
CUSTOM_LLM_TIMEOUT_SEC=90
# Sampling temperature for a custom/OpenAI-compatible provider that has no
# per-provider value set in the Providers tab. Some models accept only a fixed
# set (e.g. 0, 0.6 or 1) and reject anything else with a 400 on every call, so
# set this to an allowed value if your provider is strict — or, better, set the
# temperature on the provider itself in the UI.
LLM_TEMPERATURE=0.3
SEARCH_TIMEOUT_SEC=20
RESEARCH_TIMEOUT_SEC=1000

# Human-in-the-loop plan review. When true, a run pauses after planning and
# waits for the user to approve or edit the outline before section research
# begins. Off by default; the UI can also opt in per request.
PLAN_REVIEW_INTERACTIVE=false
PLAN_REVIEW_TIMEOUT_SEC=300
PLAN_REVIEW_ALTERNATIVES=3

# Cache (diskcache, bounded)
CACHE_SIZE_LIMIT_BYTES=250000000
CACHE_TTL_SEC=3600

# LLM response cache (v2): exact-prompt disk cache. Repeated critic re-evals
# and re-runs are served in ~1ms with zero provider spend.
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SEC=21600

# When a UI-selected active provider FAILS (timeout, rate limit, outage),
# fall through to any env-configured provider instead of degrading the run to
# extraction. false = strict exclusivity: a failing selection never spends
# another provider's key.
ACTIVE_PROVIDER_FALLBACK=true

# Provider fallback CHAINS (Providers tab). When true, an enabled user chain
# (ordered primary -> fallbacks of saved providers) replaces single-provider
# selection for LLM calls. false is an operator kill switch that leaves the
# stored chain data intact; with no chain enabled, this changes nothing.
PROVIDER_CHAINS_ENABLED=true

# Rate limiting (slowapi format) on /api/research/stream
RATE_LIMIT=5/minute

# Research pipeline composition (app/research/) -----------------------------
# These shape how a run is composed. Model/provider selection is NOT here — it
# is owned by the Model Control Center (Providers tab).
RESEARCH_TOTAL_WORDS=1200
RESEARCH_REPORT_FORMAT=APA
RESEARCH_LANGUAGE=english
RESEARCH_REPORT_SOURCE=web
RESEARCH_SMART_TOKEN_LIMIT=12000
RESEARCH_STRATEGIC_TOKEN_LIMIT=8000
RESEARCH_MAX_RESULTS_PER_QUERY=5
# Context filter: auto (BM25 keyword) | keyword | none
RESEARCH_CONTEXT_FILTER=auto
RESEARCH_COMPRESSION_THRESHOLD=8000
RESEARCH_KEYWORD_RELATIVE_THRESHOLD=0.5
RESEARCH_KEYWORD_MAX_RESULTS=25
RESEARCH_MAX_SCRAPER_WORKERS=15
RESEARCH_SCRAPER_RATE_LIMIT_DELAY=0.0
# User-Agent sent when fetching pages the retrieval layer did not pre-fetch.
# Some hosts reject a non-browser UA outright.
# RESEARCH_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/119.0.0.0 Safari/537.36
RESEARCH_DOC_PATH=./my-docs
RESEARCH_CURATE_SOURCES=false
RESEARCH_MAX_CONTENT_CHARS=50000
# Set true only to intentionally fetch internal/self-hosted resources (disables
# the SSRF/local-file guard).
ALLOW_PRIVATE_URLS=false
