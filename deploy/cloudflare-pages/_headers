# Cloudflare Pages response headers.
#
# A static demo has no server, so these are the only security controls.
# Kept deliberately conservative: the app inlines one boot script (theme) and
# loads only same-origin assets, so a strict CSP is achievable without breaking
# it. `frame-src 'self'` is required because the docs site is mounted in an
# iframe from the same origin.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'

# Hashed build assets are immutable — cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The app shell and docs must revalidate so a deploy is picked up.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/docs.html
  Cache-Control: public, max-age=0, must-revalidate
