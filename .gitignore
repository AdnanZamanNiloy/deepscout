# Self-hosted SearXNG checkout (third-party; has its own .git and venv).
# The backend only needs its HTTP endpoint (SEARXNG_URL). The instance is not
# part of this repository - a deployment supplies its own instance and
# settings.yml. Note SearXNG ships formats: [html] only, so a working
# self-hosted instance must add 'json' to search.formats or every request 403s.
searxng/

# Vendor bundle for the v3 agent integration (kept local, not versioned)
deepscout-deep-research-v3.zip
gitstat_tmp.txt

